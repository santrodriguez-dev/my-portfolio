---
import { Image } from "astro:assets";

// import profileImage from "@images/santi.jpeg";
// import profileImage from "@images/santi-formal.jpeg";
import profileImage from "@images/santi-gpt.png";
import { getCollection } from "astro:content";

const [basics] = await getCollection("basics");
---

<header class="flex justify-center items-center pt-8">
  <a class="size-40 rounded-full overflow-hidden hover:opacity-90 transition-opacity" href="/resume/detail" title="Ver imagen de perfil en grande">
    <Image
      priority
      transition:name="profile-img"
      src={profileImage}
      alt={basics?.data.name || "Santiago Rodríguez - Profile Image"}
      width="200"
    />
  </a>
</header>
