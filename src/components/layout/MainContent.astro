---
import PhoneIcon from "../../icons/PhoneIcon.astro";
import MailIcon from "../../icons/MailIcon.astro";
import LocationIcon from "../../icons/LocationIcon.astro";
import Work from "@components/Work.astro";
import Education from "@components/Education.astro";
import { getCollection } from "astro:content";
import LinkedinIcon from "../../icons/LinkedinIcon.astro";

const [basics] = await getCollection("basics");
const profileInfo = basics!.data;

const linkedin = basics?.data.profiles.find(
  (item) => item.network === "LinkedIn",
);
---

<main class="flex-1 pl-4 md:pl-6 pr-4 md:pr-5 pt-4 md:pt-8 pb-5 relative w-full md:w-auto">
  <header class="flex flex-col md:flex-row justify-between gap-y-4 md:gap-x-2">
    <div>
      <h1 class="font-bebas-neue text-3xl md:text-4xl text-[#414142]">
        <span class="block tracking-wide w-min">{profileInfo.name}</span>
      </h1>
      <p
        class="font-bebas-neue uppercase text-xs md:text-[12px] tracking-[1px] text-[#595A5C]"
      >
        {profileInfo.label}
      </p>
    </div>

    <div class="flex flex-col gap-1 text-[#595A5C] text-xs md:text-sm">
      <div class="flex gap-2 items-center">
        <LocationIcon />
        <span class="flex-1 border-b border-b-[#e6e7e8]"
          >{profileInfo.location.city}, {profileInfo.location.region}</span
        >
      </div>
      <div class="flex gap-2 items-center">
        <PhoneIcon />
        <span class="flex-1 border-b border-b-[#e6e7e8]"
          >{profileInfo.phone}</span
        >
      </div>
      <div class="flex gap-2 items-center">
        <MailIcon />
        <a
          class="flex-1 border-b border-b-[#e6e7e8] hover:underline"
          href={`mailto:${profileInfo.email}`}>{profileInfo.email}</a
        >
      </div>
      <div class="flex gap-2 items-center">
        <LinkedinIcon />
        <a class="flex-1 border-b border-b-[#e6e7e8] hover:underline" href={linkedin?.url}>
          linkedin.com/in/{linkedin?.username}
        </a>
      </div>
    </div>
  </header>

  <Work />
  <Education />
</main>
